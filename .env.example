# Copia este archivo a .env y rellena los valores.
# Nunca subas .env a Git (ya esta en .gitignore).

PORT=3780
ALLOWED_ORIGINS=http://localhost:3780,https://negas.tattoo
TRUST_PROXY_HOPS=1

# ─── Supabase ────────────────────────────────────────────────────────
SUPABASE_URL=https://qiyfydnwdwygbrpavdjb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KEEPALIVE_TABLES=leads,gallery_images

# ─── Enlaces publicos ────────────────────────────────────────────────
# OJO: el numero de WhatsApp del sitio sale de AQUI, no del codigo.
# Formato internacional sin +, sin espacios.
WHATSAPP_PHONE=573337589442
INSTAGRAM_URL=https://www.instagram.com/negas.tattoo
FACEBOOK_URL=https://www.facebook.com/negas.ink

# ─── Panel admin ─────────────────────────────────────────────────────
# Correos autorizados, separados por coma. Si se deja vacio, cualquier
# usuario autenticado de Supabase puede administrar la galeria.
ADMIN_EMAILS=

# ─── reCAPTCHA v3 ────────────────────────────────────────────────────
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# ─── Medicion y publicidad ───────────────────────────────────────────
# El Meta Pixel (1467646508235189) va directo en el HTML, no aqui.
# Estas variables activan Google Ads y GA4 cuando las rellenes.
GOOGLE_ADS_ID=
GOOGLE_ADS_CONVERSION_LABEL=
GA4_MEASUREMENT_ID=

# ─── Precios del cotizador ───────────────────────────────────────────
# Se pueden ajustar sin volver a desplegar. Formula:
#   base + min(cm,15)*PER_CM_SMALL + max(0,cm-15)*PER_CM_LARGE
#   con piso en PRICE_MINIMUM, mostrado como rango LOW..HIGH
PRICE_BASE=90000
PRICE_PER_CM_SMALL=38000
PRICE_PER_CM_LARGE=52000
PRICE_BREAKPOINT_CM=15
PRICE_MINIMUM=180000
PRICE_RANGE_LOW=0.95
PRICE_RANGE_HIGH=1.25
PRICE_MAX_CM=60

# ─── Rate limiting ───────────────────────────────────────────────────
RATE_LIMIT_API=200
RATE_LIMIT_LEAD_START=10
RATE_LIMIT_LEAD_COMPLETE=30
