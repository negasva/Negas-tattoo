# Copia este archivo a .env y rellena los valores.
# Nunca subas .env a Git (ya esta en .gitignore).

PORT=3780
ALLOWED_ORIGINS=http://localhost:3780,https://negas.tattoo
TRUST_PROXY=
RECAPTCHA_MIN_SCORE=0.5

# ImgBB: solo en servidor.
IMGBB_API_KEY=

# EmailJS: usado ahora desde el backend para evitar exponer el flujo de envio.
EMAILJS_PUBLIC_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=

# reCAPTCHA v3
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Enlaces publicos
WHATSAPP_PHONE=
INSTAGRAM_URL=
FACEBOOK_URL=
