# ════════════════════════════════════════════════════════════════════
#  PLANTILLA — este archivo SÍ se sube a Git, así que va VACÍO.
#
#  Local:   copia a .env y rellena los valores.
#  Vercel:  Project Settings → Environment Variables → pega uno por uno.
#
#  Los valores reales te los pasé por el chat. Nunca los escribas aquí.
#  Verifica que no falte ninguna abriendo /api/health en tu sitio.
# ════════════════════════════════════════════════════════════════════

# ─── Servidor ────────────────────────────────────────────────────────
# En Vercel NO pongas PORT: lo maneja la plataforma.
PORT=3780
ALLOWED_ORIGINS=http://localhost:3780,https://negas.tattoo
TRUST_PROXY_HOPS=1

# En produccion tiene que valer exactamente "production": es lo que apaga el
# comodin de CORS para localhost. Vercel ya la define sola.
NODE_ENV=development

# ─── Supabase ────────────────────────────────────────────────────────
# La anon key es pública por diseño (viaja al navegador y la protege RLS),
# pero la sacamos del código para que no quede en el repositorio.
# La SERVICE_ROLE_KEY es un secreto real: jamás llega al navegador.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KEEPALIVE_TABLES=leads,gallery_images

# ─── Enlaces públicos ────────────────────────────────────────────────
# El número de WhatsApp del sitio sale de AQUÍ, no del código.
# Formato internacional, sin + y sin espacios.
WHATSAPP_PHONE=
INSTAGRAM_URL=
FACEBOOK_URL=

# ─── Panel admin ─────────────────────────────────────────────────────
#
#  ⚠️  OBLIGATORIA. Sin ella el panel no funciona para NADIE.
#
# Correos autorizados separados por coma, en minúsculas. El servidor falla
# cerrado: lista vacía = nadie administra. (Antes era al revés — vacía dejaba
# entrar a cualquiera que se registrara en el proyecto de Supabase.)
#
#   ADMIN_EMAILS=tu-correo@ejemplo.com,otro@ejemplo.com
ADMIN_EMAILS=

# ─── Cron y diagnóstico ──────────────────────────────────────────────
# CRON_SECRET protege /api/keepalive: solo entra quien mande
# `Authorization: Bearer <este valor>`. Vercel lo hace solo con sus crons
# cuando la variable está definida en el proyecto. Sin ella, 401 siempre.
# Genera un valor al azar:  openssl rand -hex 32
CRON_SECRET=

# HEALTH_DEBUG_KEY abre /api/health, que enumera proveedores, tablas y
# errores de Postgres. Sin ella el endpoint responde 404. Llámalo con
# /api/health?key=ESE_VALOR
HEALTH_DEBUG_KEY=

# ─── reCAPTCHA v3 ────────────────────────────────────────────────────
# Sin el SECRET configurado el formulario rechaza TODO por seguridad.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# ─── Medición y publicidad ───────────────────────────────────────────
META_PIXEL_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_CONVERSION_LABEL=
GA4_MEASUREMENT_ID=

# Etiqueta de la conversion "cotizacion completa", la que se cuenta en
# /gracias con el metodo "Page load" de Google Ads. En Ads: Objetivos →
# Conversiones → la accion → Etiqueta de conversion (lo que va despues de la
# barra en send_to). Si la dejas vacia se sigue usando
# GOOGLE_ADS_CONVERSION_LABEL, asi que nunca se pierde la medicion.
GOOGLE_ADS_CONVERSION_LABEL_COMPLETA=

# ─── Precios del cotizador ───────────────────────────────────────────
# Se pueden ajustar sin volver a desplegar. Fórmula:
#   base + min(cm,15)*PER_CM_SMALL + max(0,cm-15)*PER_CM_LARGE
#   con piso en PRICE_MINIMUM, mostrado como rango LOW..HIGH
PRICE_BASE=90000
PRICE_PER_CM_SMALL=38000
PRICE_PER_CM_LARGE=52000
PRICE_BREAKPOINT_CM=15
PRICE_MINIMUM=180000
PRICE_RANGE_LOW=0.95
PRICE_RANGE_HIGH=1.25
PRICE_MAX_CM=60

# ─── Rate limiting ───────────────────────────────────────────────────
RATE_LIMIT_API=200
RATE_LIMIT_LEAD_START=10
RATE_LIMIT_LEAD_COMPLETE=30
